{
  "worktree_root": ".claude/worktrees",
  "main_ref": "origin/main",
  "build_dir": "per-slot: each slot keeps its own target/ (the default); never share CARGO_TARGET_DIR across slots. gen-docs builds into target/gen-docs, so its docgen-feature binary never replaces the tested target/debug/forklift",
  "heavy_commands": [
    {
      "pattern": "cargo[[:space:]]+(test|nextest|clippy|bench)",
      "bound_seconds": 2700
    },
    {
      "pattern": "cargo[[:space:]]+build[[:space:]].*--release",
      "bound_seconds": 1800
    },
    {
      "pattern": "bin/full-suite([[:space:]]|$)",
      "bound_seconds": 10800
    },
    {
      "pattern": "bin/(clippy-changed|gen-docs)([[:space:]]|$)",
      "bound_seconds": 1800
    },
    {
      "pattern": "bin/(check|bench\\.sh|benchmark)([[:space:]]|$)",
      "bound_seconds": 3600
    }
  ],
  "serial_resources": {
    "exit-code": {
      "kind": "counter",
      "max_cmd": "git show $REF:docs/generated/errors.md | sed -n 's/^| `[a-z_]*` | \\([0-9][0-9]*\\) |.*/\\1/p' | sort -n | tail -1"
    }
  },
  "mechanical_files": [
    {
      "glob": "docs/generated/**",
      "regenerate": "CARGO_TARGET_DIR=target/gen-docs ./bin/gen-docs"
    },
    {
      "glob": "Cargo.lock",
      "regenerate": "git checkout --theirs Cargo.lock && cargo metadata --format-version 1 >/dev/null && ./bin/check-no-aws-lc"
    },
    {
      "glob": "tools/proof-load-desktop/Cargo.lock",
      "regenerate": "git checkout --theirs tools/proof-load-desktop/Cargo.lock && cargo metadata --format-version 1 --manifest-path tools/proof-load-desktop/Cargo.toml >/dev/null"
    }
  ],
  "branch_update": "merge",
  "areas": [
    "core",
    "cli",
    "server",
    "aws",
    "infra",
    "docs",
    "bench"
  ]
}
