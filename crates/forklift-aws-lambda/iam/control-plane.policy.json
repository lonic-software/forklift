{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ObjectPlane",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "${bucket_arn}/objects/*",
        "${bucket_arn}/signatures/*",
        "${bucket_arn}/responses/*"
      ]
    },
    {
      "Sid": "StagingPlane",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "${bucket_arn}/staging/*"
    },
    {
      "Sid": "RedactionScanWork",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "${bucket_arn}/redaction-work/*"
    },
    {
      "Sid": "WithheldIntake",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "${bucket_arn}/intake/*"
    },
    {
      "Sid": "DeleteRedactedCopies",
      "Effect": "Allow",
      "Action": "s3:DeleteObjectVersion",
      "Resource": [
        "${bucket_arn}/objects/*",
        "${bucket_arn}/staging/*",
        "${bucket_arn}/responses/*",
        "${bucket_arn}/redaction-work/*"
      ]
    },
    {
      "Sid": "ListRedactedVersions",
      "Effect": "Allow",
      "Action": "s3:ListBucketVersions",
      "Resource": "${bucket_arn}"
    },
    {
      "Sid": "ListBucketFor404Semantics",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${bucket_arn}"
    },
    {
      "Sid": "RefsAndTrust",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": "${table_arn}"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": ["${log_group_arn}", "${log_group_arn}:*"]
    }
  ]
}
