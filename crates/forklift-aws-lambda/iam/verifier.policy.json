{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PromoteStagedObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:DeleteObject"],
      "Resource": "${bucket_arn}/staging/*"
    },
    {
      "Sid": "WriteCanonicalObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "${bucket_arn}/objects/*"
    },
    {
      "Sid": "ReadRedactionItems",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "${table_arn}"
    },
    {
      "Sid": "DeleteRedactedPromotions",
      "Effect": "Allow",
      "Action": "s3:DeleteObjectVersion",
      "Resource": ["${bucket_arn}/objects/*", "${bucket_arn}/staging/*"]
    },
    {
      "Sid": "ListRedactedVersions",
      "Effect": "Allow",
      "Action": "s3:ListBucketVersions",
      "Resource": "${bucket_arn}"
    },
    {
      "Sid": "ListBucketFor404Semantics",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${bucket_arn}"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": ["${log_group_arn}", "${log_group_arn}:*"]
    }
  ]
}
