# Non-secret, safe-to-commit values for the FORK-60 Layer 3 dogfood staging stack. See main.tf
# in this directory for what force_destroy/deletion_protection/warehouse_id are hardcoded to and
# why, and for the KMS-driven reasoning this whole example directory exists to pin.
#
# kms_key_arn, auth_token, control_plane_package, and verifier_package are deliberately absent
# from this file: the first two are secret/account-specific, the last two are build artifacts
# whose path differs per build. Supply all four separately — via -var, an untracked tfvars file,
# or TF_VAR_* environment variables — e.g. from the scheduled workflow's repository secrets. Do
# not add them to this file; it is meant to be committed.

region = "us-east-1"
