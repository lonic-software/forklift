#!/usr/bin/env bash
# Fails unless rustfmt is switched off for the whole tree. Forklift is formatted by hand, and the
# root rustfmt.toml sets disable_all_formatting so that `cargo fmt` is a no-op (see
# docs/guide/contributing.md, "Formatting"). bin/check and CI run this. It never formats anything.
#
# The config is checked directly, not inferred from the code: rustfmt uses the nearest
# rustfmt.toml or .rustfmt.toml above each file, so any second config file switches formatting
# back on beneath it. That is invisible to `cargo fmt --check` when the files there already happen
# to be rustfmt-clean, as about a quarter of them are.
set -euo pipefail
cd "$(dirname "$0")/.."

fail() {
    echo "fmt-guard: $1" >&2
    echo "Do not run cargo fmt; see docs/guide/contributing.md, \"Formatting\"." >&2
    exit 1
}

if ! grep -qx 'disable_all_formatting = true' rustfmt.toml 2>/dev/null; then
    fail "rustfmt.toml must exist at the repository root and contain the line 'disable_all_formatting = true'."
fi

# Tracked files plus untracked ones that are not ignored, so a local override is caught before it
# is committed.
others=()
while IFS= read -r path; do
    [ "$path" = rustfmt.toml ] && continue
    [ -e "$path" ] && others+=("$path")
done < <(git ls-files --cached --others --exclude-standard -- \
    ':(glob)**/rustfmt.toml' ':(glob)**/.rustfmt.toml')
if [ "${#others[@]}" -gt 0 ]; then
    fail "a second rustfmt config would override the root guard beneath it: ${others[*]}"
fi

# The effect, as well as the config: no file cargo fmt would reach may come out reformatted.
if ! cargo fmt --version >/dev/null 2>&1; then
    fail "cargo fmt is not installed, so the guard cannot be checked (rustup component add rustfmt)."
fi
if ! cargo fmt --all --check >/dev/null; then
    fail "cargo fmt --all --check reports files rustfmt would reformat, so the guard is not in force."
fi

echo "fmt-guard: rustfmt is switched off for the whole tree"
