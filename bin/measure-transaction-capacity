#!/usr/bin/env bash
# What does a DynamoDB TransactWriteItems actually cost, per action?
#
# This is the carrier for the capacity figures in docs/DEPLOYMENT.md ("Capacity mode"). Those
# were attested-only until 2026-08-30 — AWS's Developer Guide states DynamoDB performs two
# underlying writes per item in a transaction, but no pinned SDK source says so and no run had
# checked it. Committed so the claim can be re-run and falsified rather than trusted; a number
# in prose with no way to reproduce it rots silently.
#
# Results on 2026-08-30 (eu-central-1, items all under 1 KB):
#
#   A  single conditional UpdateItem .................... 1.0 CU
#   D  TransactWriteItems, 1 action ..................... 2.0 CU / 2.0 WCU
#   C  TransactWriteItems, 2 actions .................... 4.0 CU / 4.0 WCU
#   B  TransactWriteItems, 3 actions .................... 6.0 CU / 6.0 WCU
#
# D vs A isolates the multiplier from the action count; B/C/D show it applies per action and to
# ConditionCheck, which bills as *write* capacity despite writing nothing.
#
# Requires real AWS: LocalStack's consumed-capacity numbers are synthetic and would settle
# nothing. Touches NO deployed stack — it creates one throwaway PAY_PER_REQUEST table, measures,
# and deletes it on exit (trap). Cost is a handful of on-demand write units, well under $0.01;
# table create and delete are free.
#
#   AWS_PROFILE=<profile> bin/measure-transaction-capacity
set -euo pipefail

T=forklift-fork95-capacity-probe
R=eu-central-1
WH=probe-warehouse

# Realistic 64-hex heads, so item sizes resemble production items.
OLD=1111111111111111111111111111111111111111111111111111111111111111
NEW=2222222222222222222222222222222222222222222222222222222222222222
OFF=3333333333333333333333333333333333333333333333333333333333333333
# Stand-in for the anchor's stored JSON. Only its LENGTH matters to capacity, and this is
# about the size of a real one-key anchor; quotes are avoided so the item JSON stays simple.
ANCHOR=$(printf 'a%.0s' {1..160})

echo "### account/region"
aws sts get-caller-identity --query 'Account' --output text
echo "region: $R"

cleanup() {
  echo
  echo "### teardown"
  aws dynamodb delete-table --table-name "$T" --region "$R" --output text --query 'TableDescription.TableStatus' || true
}
trap cleanup EXIT

echo
echo "### create throwaway table"
aws dynamodb create-table --table-name "$T" --region "$R" \
  --billing-mode PAY_PER_REQUEST \
  --attribute-definitions AttributeName=wh,AttributeType=S AttributeName=entity,AttributeType=S \
  --key-schema AttributeName=wh,KeyType=HASH AttributeName=entity,KeyType=RANGE \
  --tags Key=purpose,Value=FORK-95-capacity-probe Key=ephemeral,Value=true \
  --query 'TableDescription.TableStatus' --output text
aws dynamodb wait table-exists --table-name "$T" --region "$R"

echo
echo "### seed the three items the transaction names"
aws dynamodb put-item --table-name "$T" --region "$R" --item \
  "{\"wh\":{\"S\":\"$WH\"},\"entity\":{\"S\":\"pallet#main\"},\"head\":{\"S\":\"$OLD\"}}" >/dev/null
aws dynamodb put-item --table-name "$T" --region "$R" --item \
  "{\"wh\":{\"S\":\"$WH\"},\"entity\":{\"S\":\"pallet#@office\"},\"head\":{\"S\":\"$OFF\"}}" >/dev/null
aws dynamodb put-item --table-name "$T" --region "$R" --item \
  "{\"wh\":{\"S\":\"$WH\"},\"entity\":{\"S\":\"trust\"},\"anchor\":{\"S\":\"$ANCHOR\"}}" >/dev/null
echo "seeded pallet#main, pallet#@office, trust"

echo
echo "### A. BASELINE - today's single UpdateItem, conditioned on its own head"
aws dynamodb update-item --table-name "$T" --region "$R" \
  --key "{\"wh\":{\"S\":\"$WH\"},\"entity\":{\"S\":\"pallet#main\"}}" \
  --update-expression 'SET #h = :new' \
  --condition-expression '#h = :old' \
  --expression-attribute-names '{"#h":"head"}' \
  --expression-attribute-values "{\":new\":{\"S\":\"$NEW\"},\":old\":{\"S\":\"$OLD\"}}" \
  --return-consumed-capacity TOTAL \
  --query 'ConsumedCapacity' --output json

echo
echo "### B. THREE-ACTION transaction - Update(pallet) + ConditionCheck(office) + ConditionCheck(anchor)"
cat > /tmp/fork95-txn3.json <<JSON
[
  {"Update": {"TableName":"$T",
    "Key":{"wh":{"S":"$WH"},"entity":{"S":"pallet#main"}},
    "UpdateExpression":"SET #h = :new",
    "ConditionExpression":"#h = :old",
    "ExpressionAttributeNames":{"#h":"head"},
    "ExpressionAttributeValues":{":new":{"S":"$OLD"},":old":{"S":"$NEW"}},
    "ReturnValuesOnConditionCheckFailure":"ALL_OLD"}},
  {"ConditionCheck": {"TableName":"$T",
    "Key":{"wh":{"S":"$WH"},"entity":{"S":"pallet#@office"}},
    "ConditionExpression":"#h = :h",
    "ExpressionAttributeNames":{"#h":"head"},
    "ExpressionAttributeValues":{":h":{"S":"$OFF"}},
    "ReturnValuesOnConditionCheckFailure":"ALL_OLD"}},
  {"ConditionCheck": {"TableName":"$T",
    "Key":{"wh":{"S":"$WH"},"entity":{"S":"trust"}},
    "ConditionExpression":"attribute_exists(#a)",
    "ExpressionAttributeNames":{"#a":"anchor"},
    "ReturnValuesOnConditionCheckFailure":"ALL_OLD"}}
]
JSON
aws dynamodb transact-write-items --region "$R" \
  --transact-items file:///tmp/fork95-txn3.json \
  --return-consumed-capacity TOTAL \
  --query 'ConsumedCapacity' --output json

echo
echo "### C. TWO-ACTION transaction - the target-is-@office case (office check dropped)"
cat > /tmp/fork95-txn2.json <<JSON
[
  {"Update": {"TableName":"$T",
    "Key":{"wh":{"S":"$WH"},"entity":{"S":"pallet#@office"}},
    "UpdateExpression":"SET #h = :new",
    "ConditionExpression":"#h = :old",
    "ExpressionAttributeNames":{"#h":"head"},
    "ExpressionAttributeValues":{":new":{"S":"$NEW"},":old":{"S":"$OFF"}},
    "ReturnValuesOnConditionCheckFailure":"ALL_OLD"}},
  {"ConditionCheck": {"TableName":"$T",
    "Key":{"wh":{"S":"$WH"},"entity":{"S":"trust"}},
    "ConditionExpression":"attribute_exists(#a)",
    "ExpressionAttributeNames":{"#a":"anchor"},
    "ReturnValuesOnConditionCheckFailure":"ALL_OLD"}}
]
JSON
aws dynamodb transact-write-items --region "$R" \
  --transact-items file:///tmp/fork95-txn2.json \
  --return-consumed-capacity TOTAL \
  --query 'ConsumedCapacity' --output json

echo
echo "### D. SINGLE-ACTION transaction - isolates the transaction multiplier from action count"
cat > /tmp/fork95-txn1.json <<JSON
[
  {"Update": {"TableName":"$T",
    "Key":{"wh":{"S":"$WH"},"entity":{"S":"pallet#main"}},
    "UpdateExpression":"SET #h = :new",
    "ConditionExpression":"#h = :old",
    "ExpressionAttributeNames":{"#h":"head"},
    "ExpressionAttributeValues":{":new":{"S":"$NEW"},":old":{"S":"$OLD"}},
    "ReturnValuesOnConditionCheckFailure":"ALL_OLD"}}
]
JSON
aws dynamodb transact-write-items --region "$R" \
  --transact-items file:///tmp/fork95-txn1.json \
  --return-consumed-capacity TOTAL \
  --query 'ConsumedCapacity' --output json

echo
echo "### done - teardown follows"
