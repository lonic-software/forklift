#!/usr/bin/env bash
# Regenerate the parts of the docs that are derivable from code: the error/exit-code
# reference table, the command and alias list, and every command's `--json` output schema.
# All come out of the `forklift` binary itself, built with the dev-only `docgen` feature
# (never enabled in a release build — see crates/forklift/Cargo.toml and
# crates/forklift/src/docgen.rs).
#
# usage: gen-docs              regenerate docs/generated in place (then commit the result)
#        gen-docs --check      regenerate into a scratch directory and diff it against
#                              docs/generated; exits 1 if anything is stale, missing or extra.
#                              bin/check and CI run this.
#
# Runs whatever binary cargo just built, so a CARGO_TARGET_DIR (or a configured target-dir)
# lets it build outside the main checkout's target/.
set -euo pipefail
cd "$(dirname "$0")/.."

# Each page is rendered by `forklift __docgen <target>` into docs/generated/<target>.md.
pages=(errors json-schemas commands)

check=false
case "${1:-}" in
    "") ;;
    --check) check=true ;;
    *) echo "usage: gen-docs [--check]" >&2; exit 2 ;;
esac

if $check; then
    out="$(mktemp -d)"
    trap 'rm -rf "$out"' EXIT
else
    out="docs/generated"
    mkdir -p "$out"
    # Render each page into a temp file and move it into place only on success: a renderer
    # that refuses its page must leave the committed copy untouched, not truncated.
    trap 'for p in "${pages[@]}"; do rm -f "$out/$p.md.tmp"; done' EXIT
fi

echo "── building forklift --features docgen"
# Take the binary's path from cargo's own report of what it built, rather than guessing it:
# the target directory can come from CARGO_TARGET_DIR, CARGO_BUILD_TARGET_DIR or any
# .cargo/config.toml, and a build.target triple adds a directory level. Only an executable
# target reports a path ("executable":null otherwise), and -p forklift builds one.
bin="$(cargo build --quiet -p forklift --features docgen --message-format=json-render-diagnostics \
    | sed -n 's/.*"executable":"\([^"]*\)".*/\1/p' | tail -n 1)"
if [ -z "$bin" ]; then
    echo "gen-docs: cargo reported no forklift executable" >&2
    exit 1
fi

for page in "${pages[@]}"; do
    "$bin" __docgen "$page" > "$out/$page.md.tmp"
done
for page in "${pages[@]}"; do
    mv "$out/$page.md.tmp" "$out/$page.md"
done

if $check; then
    # A plain recursive diff also catches a generated page deleted from, or a stray file
    # added to, docs/generated.
    if ! diff -ru docs/generated "$out"; then
        echo
        echo "docs/generated/ is stale — run ./bin/gen-docs and commit the result." >&2
        exit 1
    fi
    echo "gen-docs: docs/generated is up to date"
else
    echo "gen-docs: wrote ${pages[*]/%/.md} in $out"
fi
