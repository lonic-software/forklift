#!/usr/bin/env bash
# The formatting guard, build, tests and clippy CI runs (.github/workflows/ci.yml). CI runs the
# same tests under cargo-nextest, one process per test, plus `cargo test --doc`;
# `cargo test` here covers both in one go. CI's clippy is report-only (style-level lint
# debt is tracked separately), so this doesn't fail on lint warnings — the
# formatting guard, the build and the tests are the gate.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "── formatting guard (cargo fmt --check)"
# The tree is formatted by hand and rustfmt.toml switches rustfmt off, so this passes only while
# that guard is in force. Removed or overridden (a nested rustfmt.toml), `cargo fmt` would rewrite
# about half the tree, and this reports it instead. It never formats anything itself.
if ! cargo fmt --all --check >/dev/null; then
    echo
    echo "cargo fmt would reformat the tree: rustfmt.toml's disable_all_formatting guard is missing" >&2
    echo "or overridden. Restore it; do not run cargo fmt (see docs/guide/contributing.md)." >&2
    exit 1
fi

echo "── cargo build --workspace"
cargo build --workspace

echo "── cargo test --workspace"
cargo test --workspace

echo "── cargo clippy --workspace (report-only, like CI)"
cargo clippy --workspace || true

echo "── docs freshness (bin/gen-docs)"
# Regenerate into a scratch directory (never touching docs/generated in place) and diff —
# catches both stale content and a deleted generated file, without side effects on a green run.
docs_scratch="$(mktemp -d)"
trap 'rm -rf "$docs_scratch"' EXIT
./bin/gen-docs "$docs_scratch" >/dev/null
if ! diff -ru docs/generated "$docs_scratch"; then
    echo
    echo "docs/generated/ is stale — run ./bin/gen-docs and commit the result." >&2
    exit 1
fi

echo "check: formatting guard + build + tests + docs green"
