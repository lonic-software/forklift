#!/usr/bin/env bash
# The complete local suites: what to run before opening a pull request or pushing to one, so that CI
# is never the first run of a test. bin/check is the fast subset; this is everything CI and the side
# workflows would run that this machine can run:
#
#   build      cargo build --workspace (the tests drive the forklift and forklift-server binaries,
#              and cargo test -p forklift does not rebuild forklift-server)
#   test       cargo test --workspace --no-fail-fast (unit, integration and doc-tests)
#   history    proof-load's ignored tests (the history lane and the round trips), against the
#              forklift binary the workspace build made, wherever its target directory is
#   desktop    tools/proof-load-desktop, its own workspace: tests, then clippy -D warnings
#   clippy     cargo clippy --workspace --all-targets, so clippy.toml's bans reach the tests too;
#              report-only like CI, its log is what bin/clippy-changed reads
#   guards     bin/fmt-guard, bin/gen-docs --check (which builds into target/gen-docs, so its
#              docgen build never replaces the tested binary) and bin/check-no-aws-lc
#
# usage: full-suite [--out DIR] [--only STEP,...]
#        full-suite --list
#        full-suite --self-test
#
# Every step runs under its own watchdog, so a hung test cannot hold the run forever; its whole
# output goes to DIR/<step>.log (default: a fresh temporary directory, printed first) and one line
# per step is printed, with the first failing line of any step that did not pass. A failed build
# stops the run, since every later step would rebuild and fail the same way; any other failure does
# not. Exits 0 only when every step ran and passed, 1 otherwise, 2 on a usage error.
#
# Bash 3.2 compatible; the watchdog is perl's alarm, since macOS has no timeout.
set -euo pipefail

# name|seconds|command — run from the repository root. FULL_SUITE_TABLE names a file to read in
# its place: the self-test's way to drive the real entry point with steps of its own.
steps() {
    if [ -n "${FULL_SUITE_TABLE:-}" ]; then cat "$FULL_SUITE_TABLE"; return; fi
    cat <<'EOF'
build|1800|cargo build --workspace
test|3600|cargo test --workspace --no-fail-fast
history|1800|set -o pipefail && PROOF_LOAD_FORKLIFT="$(cargo build -q --workspace --message-format=json-render-diagnostics | sed -n 's/.*"executable":"\([^"]*\/forklift\)".*/\1/p' | tail -1)" && [ -x "$PROOF_LOAD_FORKLIFT" ] && export PROOF_LOAD_FORKLIFT && cargo test -p proof-load --lib -- --ignored
desktop|1800|cargo test --locked --no-fail-fast --manifest-path tools/proof-load-desktop/Cargo.toml && cargo clippy --locked --all-targets --manifest-path tools/proof-load-desktop/Cargo.toml -- -D warnings
clippy|1800|cargo clippy --workspace --all-targets --message-format=short
guards|900|./bin/fmt-guard && ./bin/gen-docs --check && ./bin/check-no-aws-lc
EOF
}

# The patterns that say why a step failed, most telling first: the first pattern with a match in the
# log names the step's failure. None is a bare word a passing test's name could hold.
FAIL_RES=('^test .* FAILED$' 'panicked at' '^error(\[|:)' 'fmt-guard:' 'check-no-aws-lc:'
    'docs/generated/ is stale' '^diff ' '^failures:')

# why LOG: the first line of LOG that the most telling matching pattern finds, else its last line.
why() {
    local re
    for re in "${FAIL_RES[@]}"; do
        grep -E -m1 -- "$re" "$1" && return 0
    done
    tail -1 "$1"
}

# Runs the command in its own process group and kills the whole group on timeout (exit 142): a test
# binary's children would otherwise outlive the watchdog. It execs, so a backgrounded call's pid is
# the watchdog's own and a signal sent to it reaches the handler below.
bounded() {
    exec perl -e '
        my $t = shift;
        my $pid = fork; defined $pid or exit 126;
        # The step gets INT and QUIT back at their defaults: a background job starts with both
        # ignored, and the tests must run in the signal environment CI gives them.
        if ($pid == 0) { setpgrp(0, 0); $SIG{INT} = $SIG{QUIT} = "DEFAULT"; exec @ARGV or exit 127 }
        setpgrp($pid, $pid);
        $SIG{ALRM} = sub { kill "TERM", -$pid; sleep 2; kill "KILL", -$pid; exit 142 };
        # Dies of the same signal once the group is gone, so the caller sees an interrupt, not a
        # failure, and stops too.
        $SIG{$_} = do { my $s = $_; sub { kill "TERM", -$pid; $SIG{$s} = "DEFAULT"; kill $s, $$; exit 143 } }
            for qw(INT TERM HUP);
        alarm $t; waitpid $pid, 0; alarm 0;
        exit($? & 127 ? 128 + ($? & 127) : $? >> 8)' "$@"
}

STEP_PID=""
# forward SIG: hands SIG to the running step's watchdog, waits for it, then dies of SIG.
forward() {
    if [ -n "$STEP_PID" ]; then kill -s "$1" "$STEP_PID" 2>/dev/null || true; wait "$STEP_PID" 2>/dev/null || true; fi
    trap - "$1"
    kill -s "$1" $$
}

# run_steps OUT ONLY < table: runs each selected step, prints its line, returns 1 if any failed.
run_steps() {
    local out=$1 only=$2 failed=0 name secs cmd t0 st took why
    trap 'forward INT' INT; trap 'forward TERM' TERM; trap 'forward HUP' HUP
    while IFS='|' read -r name secs cmd; do
        [ -n "$name" ] || continue
        if [ -n "$only" ]; then
            case ",$only," in *",$name,"*) ;; *) continue ;; esac
        fi
        t0=$(date +%s)
        set +e
        # In the background, so a TERM or HUP sent to this script alone (a parent's bound) reaches
        # the trap while the step runs; the trap passes it to the watchdog, which kills the step's
        # whole group, and then this script dies of the same signal.
        bounded "$secs" bash -c "$cmd" > "$out/$name.log" 2>&1 < /dev/null &
        STEP_PID=$!
        wait "$STEP_PID"
        st=$?
        STEP_PID=""
        set -e
        took=$(( $(date +%s) - t0 ))
        if [ "$st" -eq 0 ]; then
            printf 'ok       %-8s %5ss\n' "$name" "$took"
            continue
        fi
        failed=1
        if [ "$st" -eq 142 ]; then
            printf 'TIMEOUT  %-8s %5ss  (watchdog %ss; log %s)\n' "$name" "$took" "$secs" "$out/$name.log"
        else
            why=$(why "$out/$name.log" || true)
            printf 'FAILED   %-8s %5ss  exit %s: %s\n' "$name" "$took" "$st" "$why"
        fi
        if [ "$name" = build ]; then
            echo "full-suite: the build failed, so nothing else was run (log $out/build.log)"
            return 1
        fi
    done
    return "$failed"
}

self_test() {
    local tmp fails=0 out st
    tmp="$(mktemp -d)"
    check() { # name want-exit want-text
        if [ "$st" -eq "$2" ] && printf '%s' "$out" | grep -q -- "$3"; then
            echo "ok   $1"
        else
            echo "FAIL $1 (exit $st, want $2; want text: $3)"; printf '%s\n' "$out" | sed 's/^/     /'
            fails=$((fails + 1))
        fi
    }
    mkdir -p "$tmp/a" "$tmp/b" "$tmp/c" "$tmp/d"

    set +e
    out=$(run_steps "$tmp/a" "" <<'EOF'
build|5|true
test|5|echo 'test x ... FAILED'; exit 101
clippy|5|echo clean
EOF
    ); st=$?
    set -e
    check "a failing step fails the run" 1 "FAILED   test"
    check "the failing line is named" 1 "test x ... FAILED"
    check "a step after a failure still runs" 1 "ok       clippy"

    set +e
    out=$(run_steps "$tmp/b" "" <<'EOF'
build|5|echo 'error: could not compile'; exit 101
test|5|true
EOF
    ); st=$?
    set -e
    check "a failed build stops the run" 1 "nothing else was run"
    if printf '%s' "$out" | grep -q "ok       test"; then
        echo "FAIL a failed build runs nothing after it"; fails=$((fails + 1))
    else
        echo "ok   a failed build runs nothing after it"
    fi

    set +e
    out=$(run_steps "$tmp/c" "" <<'EOF'
test|1|sleep 30 & wait
EOF
    ); st=$?
    set -e
    check "a hung step is a TIMEOUT, not a hang" 1 "TIMEOUT  test"

    set +e
    out=$(run_steps "$tmp/d" "clippy" <<'EOF'
build|5|exit 1
clippy|5|true
EOF
    ); st=$?
    set -e
    check "--only runs just the named steps" 0 "ok       clippy"

    set +e
    out=$(run_steps "$tmp/d" "" <<'EOF'
build|5|true
test|5|true
EOF
    ); st=$?
    set -e
    check "every step passing passes the run" 0 "ok       test"

    mkdir -p "$tmp/e" "$tmp/f"
    set +e
    out=$(run_steps "$tmp/e" "" <<'EOF'
build|5|true
test|5|echo 'test tests::stale_requests_are_refused ... ok'; echo 'test x ... FAILED'; exit 101
EOF
    ); st=$?
    set -e
    check "a passing test named stale is not the failure" 1 "exit 101: test x ... FAILED"

    # A Ctrl-C (INT to the whole foreground group) stops the run: the step after never starts.
    # A TERM to the script alone (a parent's bound) leaves no step running behind it.
    local sig pid n want
    printf '%s\n' 'test|30|echo $$ > "$FULL_SUITE_SELF_TEST_PID"; exec sleep 20' 'clippy|5|echo after' \
        > "$tmp/table"
    for sig in INT TERM; do
        mkdir -p "$tmp/$sig"
        export FULL_SUITE_SELF_TEST_PID="$tmp/$sig/step.pid"
        # The real entry point, in a process group of its own with INT at its default, as a
        # terminal's foreground job would be (a background job starts with INT ignored, which a
        # shell cannot trap).
        FULL_SUITE_TABLE="$tmp/table" perl -e '$SIG{INT} = "DEFAULT"; setpgrp(0, 0); exec @ARGV' \
            bash "$0" --out "$tmp/$sig" > "$tmp/$sig.out" 2>&1 &
        pid=$!
        n=0; while [ ! -s "$tmp/$sig/step.pid" ] && [ "$n" -lt 100 ]; do sleep 0.1; n=$((n + 1)); done
        if [ "$sig" = INT ]; then kill -INT -- "-$pid"; want=130; else kill -TERM "$pid"; want=143; fi
        set +e; { wait "$pid"; } 2>/dev/null; st=$?; set -e
        n=0; while kill -0 "$(cat "$tmp/$sig/step.pid" 2>/dev/null || echo 0)" 2>/dev/null && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
        if [ -f "$tmp/$sig/clippy.log" ]; then out="the next step ran"
        elif kill -0 "$(cat "$tmp/$sig/step.pid" 2>/dev/null || echo 0)" 2>/dev/null; then out="the step outlived the run"
        else out="stopped"; fi
        check "a $sig stops the run and its step" "$want" "stopped"
    done
    unset FULL_SUITE_SELF_TEST_PID

    # A step runs with INT at its default, though the watchdog is a background job.
    printf '%s\n' 'test|5|perl -e '"'"'print $SIG{INT} // "DEFAULT"'"'"'; [ "$(perl -e '"'"'print $SIG{INT} // ""'"'"')" != IGNORE ]' > "$tmp/table2"
    set +e
    out=$(FULL_SUITE_TABLE="$tmp/table2" bash "$0" --out "$tmp/g" 2>&1); st=$?
    set -e
    check "a step does not inherit an ignored INT" 0 "ok       test"

    rm -rf "$tmp"
    if [ "$fails" -eq 0 ]; then echo "self-test: all passed"; return 0; fi
    echo "self-test: $fails failed"; return 1
}

out=""
only=""
while [ $# -gt 0 ]; do
    case "$1" in
        --out) out=${2:?--out needs a directory}; shift 2 ;;
        --only) only=${2:?--only needs step names}; shift 2 ;;
        --list) steps | cut -d'|' -f1; exit 0 ;;
        --self-test) self_test; exit $? ;;
        *) echo "usage: full-suite [--out DIR] [--only STEP,...] | --list | --self-test" >&2; exit 2 ;;
    esac
done

cd "$(dirname "$0")/.."
if [ -n "$only" ]; then
    for name in $(printf '%s' "$only" | tr ',' ' '); do
        steps | cut -d'|' -f1 | grep -qx -- "$name" || { echo "full-suite: no step named '$name' (see --list)" >&2; exit 2; }
    done
fi
if [ -z "$out" ]; then out="$(mktemp -d)"; fi
mkdir -p "$out"
echo "full-suite: $(git rev-parse --short HEAD)$( [ -z "$(git status --porcelain)" ] || echo ' (uncommitted changes)'), logs in $out"
set +e
# In this shell, not a pipeline's subshell: the traps run_steps sets must be this process's own,
# so a signal sent to the script reaches them.
run_steps "$out" "$only" < <(steps)
st=$?
set -e
if [ "$st" -eq 0 ]; then echo "full-suite: every step passed"; else echo "full-suite: NOT green"; fi
exit "$st"
