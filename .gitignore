/target
.idea/
.forklift/
# Claude Code's local state; the merge-gate and fleet configs are shared.
.claude/*
!.claude/gates.json
!.claude/fleet.json
# Scratch dev warehouse used by `bin/serve` (pult serve).
.dev/
# macOS Finder metadata.
.DS_Store

# OpenTofu/Terraform (infra/aws-serverless): local plugin cache and any state a stray apply
# leaves behind. The provider lock file (.terraform.lock.hcl) is NOT ignored — that one is
# meant to be committed for reproducible provider selection.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Local-only remote-state wiring; the committed examples stay backend-free for public consumers.
backend_override.tf

# Cross-compiled Lambda build output (cargo target dir used by the Linux container build).
target-lambda-docker/

# Trace build output (cargo target dir used for tracing builds).
/target-trace/
